---
import { getEntry, render } from 'astro:content'

import SimplePage from '@/components/site/SimplePage.astro'

const entry = await getEntry('pages', 'tr/privacy')
if (!entry) throw new Error('missing privacy page (tr)')
const { Content } = await render(entry)
---

<SimplePage
  lang='tr'
  title={entry.data.title}
  description={entry.data.description}
  updatedDate={entry.data.updatedDate}
  altHref='/en/privacy/'
>
  <Content />
</SimplePage>
