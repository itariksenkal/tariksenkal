---
import Search from './Search.astro'
import { paths, t, type Lang } from '@/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const s = t(lang)
const other: Lang = lang === 'tr' ? 'en' : 'tr'
---

<BaseLayout {lang} altHref={paths.search(other)} meta={{ title: s.searchTitle, description: s.searchDesc }}>
  <main class='mx-auto max-w-3xl'>
    <header id='content-header' class='animate'>
      <h1 class='text-3xl font-medium'>{s.searchTitle}</h1>
      <p class='mt-3 text-muted-foreground'>{s.searchDesc}. {s.searchHint}</p>
    </header>
    <div id='content' class='animate mt-8'>
      <Search {lang} />
    </div>
  </main>
</BaseLayout>
