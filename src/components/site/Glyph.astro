---

<svg
  xmlns='http://www.w3.org/2000/svg'
  viewBox='0 0 24 24'
  class={className}
  width={size}
  height={size}
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? 'none' : 'currentColor'}
  stroke-width='1.75'
  stroke-linecap='round'
  stroke-linejoin='round'
  aria-hidden='true'
  set:html={body}
/>
