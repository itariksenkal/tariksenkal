---
import { categoryCounts, getPosts, paths, slugify, t, type Lang } from '@/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Glyph from './Glyph.astro'
import PostCard from './PostCard.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const s = t(lang)
const other: Lang = lang === 'tr' ? 'en' : 'tr'
const posts = await getPosts(lang)
const cats = categoryCounts(posts)
---

<BaseLayout {lang} altHref={paths.blog(other)} meta={{ title: s.blogTitle, description: s.blogDesc }}>
  <main>
    <header id='content-header' class='animate flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between'>
      <div>
        <h1 class='text-3xl font-medium'>{s.blogTitle}</h1>
        <p class='mt-3 max-w-2xl text-muted-foreground'>{s.blogDesc}</p>
      </div>
      <div class='flex shrink-0 items-center gap-2'>
        <a href={paths.search(lang)} class='chip'><Glyph name='search' class='size-4' />{s.nav.search}</a>
        <a href={paths.rss(lang)} class='chip' title='RSS'><Glyph name='rss' class='size-4' />RSS</a>
        <div class='flex rounded-full border p-0.5' role='group'>
          <button class='view-btn rounded-full p-1.5' data-view='grid' title='Grid' aria-pressed='true'>
            <Glyph name='layers' class='size-4' />
          </button>
          <button class='view-btn rounded-full p-1.5' data-view='list' title='List' aria-pressed='false'>
            <Glyph name='list' class='size-4' />
          </button>
        </div>
      </div>
    </header>

    <div id='content' class='animate mt-8'>
      <div class='flex flex-wrap gap-2' role='group' aria-label={s.filterBy}>
        <button class='chip' data-filter='' aria-pressed='true'>
          {s.all}
          <span class='count'>{posts.length}</span>
        </button>
        {
          cats.map(([name, n]) => (
            <button
              class='chip'
              data-extra={n < 2 && cats.length > 12 ? 'true' : undefined}
              data-filter={slugify(name)}
              data-name={name}
              aria-pressed='false'
            >
              {name}
              <span class='count'>{n}</span>
            </button>
          ))
        }
        {
          cats.length > 12 && cats.some(([, n]) => n < 2) && (
            <button class='chip border-dashed' id='more-chips' type='button'>
              + {cats.filter(([, n]) => n < 2).length}
            </button>
          )
        }
      </div>

      <p class='mt-6 text-sm text-muted-foreground' id='result-count' data-template={s.postsCount(0)}>
        {s.postsCount(posts.length)}
      </p>

      <ul id='view-grid' class='mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3'>
        {posts.map((post, i) => <PostCard {post} eager={i < 3} />)}
      </ul>
      <ul id='view-list' class='mt-4 hidden flex-col gap-y-1'>
        {posts.map((post) => <PostCard {post} variant='row' />)}
      </ul>
    </div>
  </main>
</BaseLayout>

<script>
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')]
  const items = [...document.querySelectorAll<HTMLElement>('#view-grid > li, #view-list > li')]
  const count = document.getElementById('result-count')!
  const template = count.dataset.template || '0'

  function apply(key: string) {
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === key)))
    let n = 0
    items.forEach((li) => {
      const show = !key || li.dataset.category === key
      li.dataset.hidden = String(!show)
      if (show && li.parentElement?.id === 'view-grid') n++
    })
    count.textContent = template.replace('0', String(n))
    const url = new URL(location.href)
    const name = chips.find((c) => c.dataset.filter === key)?.dataset.name
    if (name) url.searchParams.set('c', name)
    else url.searchParams.delete('c')
    history.replaceState(null, '', url)
  }
  chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.filter || '')))

  const more = document.getElementById('more-chips')
  const showAll = () => {
    document.querySelectorAll('[data-extra]').forEach((c) => c.removeAttribute('data-extra'))
    more?.remove()
  }
  more?.addEventListener('click', showAll)

  const initial = new URL(location.href).searchParams.get('c')
  if (initial) {
    const match = chips.find((c) => c.dataset.name === initial)
    if (match) {
      if (match.hasAttribute('data-extra')) showAll()
      apply(match.dataset.filter || '')
    }
  }

  // Grid / list view, remembered per browser
  const grid = document.getElementById('view-grid')!
  const list = document.getElementById('view-list')!
  const btns = [...document.querySelectorAll<HTMLButtonElement>('.view-btn')]
  function setView(v: string) {
    const isList = v === 'list'
    grid.classList.toggle('hidden', isList)
    grid.classList.toggle('grid', !isList)
    list.classList.toggle('hidden', !isList)
    list.classList.toggle('flex', isList)
    btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === v)))
    try {
      localStorage.setItem('blog-view', v)
    } catch {}
  }
  btns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.view || 'grid')))
  try {
    const saved = localStorage.getItem('blog-view')
    if (saved) setView(saved)
  } catch {}
</script>

<style>
  .view-btn {
    color: hsl(var(--muted-foreground));
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .view-btn[aria-pressed='true'] {
    background: hsl(var(--muted));
    color: hsl(var(--foreground));
  }
</style>
