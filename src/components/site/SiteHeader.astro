---
// Bilingual version of astro-pure's floating header, with a language switch.
import { Image } from 'astro:assets'

import avatar from '@/assets/avatar.jpeg'
import { site } from '@/data/profile'
import { paths, t, type Lang } from '@/i18n'
import Glyph from './Glyph.astro'

interface Props {
  lang: Lang
  /** URL of this page in the other language (falls back to that language's home) */
  altHref?: string
}
const { lang, altHref } = Astro.props
const s = t(lang)
const other: Lang = lang === 'tr' ? 'en' : 'tr'
const switchHref = altHref ?? paths.home(other)
const current = Astro.url.pathname

const menu = [
  { title: s.nav.blog, link: paths.blog(lang), match: [paths.blog(lang), lang === 'en' ? '/en/posts/' : '/posts/'] },
  { title: s.nav.tags, link: paths.tags(lang), match: [paths.tags(lang)] },
  { title: s.nav.about, link: paths.about(lang), match: [] as string[] }
]
const isActive = (m: string[]) => m.some((p) => current.startsWith(p))
---

<header-component
  class='group sticky top-4 z-50 max-md:z-30 mb-12 flex items-center justify-between rounded-xl border border-transparent max-sm:py-1 sm:rounded-2xl'
  data-theme-labels={JSON.stringify(s.theme)}
>
  <a
    class='z-30 flex items-center gap-x-2.5 text-lg font-medium group-[.not-top]:ms-2 sm:group-[.not-top]:ms-3'
    style='transition:margin-inline 0.3s'
    href={paths.home(lang)}
    aria-label={s.nav.home}
  >
    <Image
      src={avatar}
      alt=''
      width={64}
      height={64}
      class='size-7 rounded-full border object-cover opacity-0 transition-opacity duration-300 group-[.not-top]:opacity-100 max-sm:hidden'
      loading='eager'
    />
    <span>{site.shortName}</span>
  </a>

  <div class='flex items-center gap-x-2'>
    <div
      id='headerExpandContent'
      class='end-0 start-0 top-12 grid border border-transparent group-[.not-top]:rounded-xl group-[.expanded]:opacity-100 dark:group-[.expanded.not-top]:bg-muted max-sm:absolute max-sm:opacity-0 max-sm:group-[.not-top]:border-border max-sm:group-[.expanded.not-top]:bg-background max-sm:group-[.not-top]:px-4 max-sm:group-[.not-top]:py-2 sm:grid-rows-1'
    >
      <nav class='flex flex-col items-center justify-center overflow-hidden sm:flex-row' aria-label={s.menu}>
        {
          menu.map((item) => (
            <a
              href={item.link}
              class:list={[
                'w-full flex-none grow py-2 text-right font-medium transition-none hover:text-primary sm:w-fit sm:px-3',
                isActive(item.match) && 'text-primary'
              ]}
              aria-current={isActive(item.match) ? 'page' : undefined}
              data-astro-prefetch
            >
              {item.title}
            </a>
          ))
        }
        <div class='flex w-full grow flex-row justify-end gap-x-3 sm:w-fit sm:gap-x-4'>
          <a class='px-1 py-2 transition-none hover:text-primary sm:px-2' href={paths.search(lang)} title={s.nav.search}>
            <span class='sr-only'>{s.nav.search}</span>
            <Glyph name='search' class='size-5' />
          </a>
        </div>
      </nav>
    </div>

    <div class='z-30 flex gap-x-2.5 group-[.not-top]:gap-x-2' style='transition:gap 0.3s'>
      <a
        href={switchHref}
        hreflang={other}
        lang={other}
        title={s.switchTo}
        class='lang-switch box-content flex h-5 items-center rounded-md border px-2 py-1.5 text-xs font-semibold tracking-wide transition-colors hover:bg-border hover:text-primary sm:group-[.not-top]:rounded-xl'
      >
        {s.switchShort}
      </a>
      <button
        id='toggleDarkMode'
        class='group/dark box-content size-5 rounded-md border p-1.5 transition-colors hover:bg-border sm:group-[.not-top]:rounded-xl'
        title={s.theme.set}
      >
        <span class='sr-only'>{s.theme.set}</span>
        <Glyph class='system size-5 group-hover/dark:text-primary' name='monitor' />
        <Glyph class='light hidden size-5 group-hover/dark:text-primary' name='sun' />
        <Glyph class='dark hidden size-5 group-hover/dark:text-primary' name='moon' />
      </button>
      <button
        id='toggleMenu'
        class='rounded-md border p-1.5 transition-colors hover:bg-border sm:hidden sm:group-[.not-top]:rounded-xl'
        aria-label={s.menu}
      >
        <Glyph class='size-5' name='menu' />
      </button>
    </div>
  </div>
</header-component>

<script is:inline>
  const toggleDarkModeElement = document.getElementById('toggleDarkMode')
  if (toggleDarkModeElement) toggleDarkModeElement.dataset.theme = localStorage.getItem('theme') || 'system'
</script>
<script>
  import { setTheme, showToast } from 'astro-pure/utils'

  class HeaderComponent extends HTMLElement {
    connectedCallback() {
      let preScrollY = window.scrollY
      this.classList.toggle('not-top', preScrollY > 20)
      window.addEventListener(
        'scroll',
        () => {
          this.classList.toggle('not-top', window.scrollY > 20)
          this.dataset.show = (window.scrollY < 350 || window.scrollY < preScrollY).toString()
          preScrollY = window.scrollY
        },
        { passive: true }
      )

      const labels = JSON.parse(this.dataset.themeLabels || '{}')
      const darkModeBtn = this.querySelector('#toggleDarkMode') as HTMLElement
      darkModeBtn.addEventListener('click', () => {
        const newTheme = setTheme(undefined, true) as 'system' | 'light' | 'dark'
        darkModeBtn.dataset.theme = newTheme
        showToast({ message: labels[newTheme] ?? newTheme })
      })

      this.querySelector('#toggleMenu')?.addEventListener('click', () => this.classList.toggle('expanded'))
    }
  }
  customElements.define('header-component', HeaderComponent)
</script>

<style>
  header-component {
    transition:
      padding 0.3s,
      transform 0.3s,
      margin-inline 0.3s,
      border 0.15s,
      background-color 0.15s;

    &.not-top {
      border-color: hsl(var(--border) / 1);
      background-color: hsl(var(--background) / 0.82);
      backdrop-filter: saturate(1.4) blur(12px);
      -webkit-backdrop-filter: saturate(1.4) blur(12px);
      padding-left: 0.375rem;
      padding-right: 0.375rem;
      box-shadow:
        rgba(24, 24, 27, 0.06) 0px 0px 0px 1px,
        rgba(39, 39, 42, 0.08) 0px 10px 15px -3px,
        rgba(39, 39, 42, 0.06) 0px 4px 6px -4px;
    }
    &[data-show='false']:not(.expanded) {
      transform: translateY(-5rem);
    }
  }
  @media (min-width: 800px) {
    header-component.not-top {
      margin-inline: 8%;
    }
  }
  :global(.dark) header-component.not-top {
    background-color: hsl(var(--muted) / 0.82);
  }

  @media (max-width: 640px) {
    #headerExpandContent {
      grid-template-rows: 0fr;
      transition:
        opacity 0.3s,
        padding 0.3s,
        border-color 0.15s,
        grid-template-rows 0.3s;
    }
    .expanded #headerExpandContent {
      grid-template-rows: 1fr;
    }
    header-component #headerExpandContent::after {
      box-sizing: content-box;
      content: '';
      position: absolute;
      inset-inline: calc(-1rem - 1px);
      bottom: 0;
      top: -5rem;
      z-index: -1;
      transition: 0.3s;
      visibility: hidden;
      opacity: 0;
      border-bottom: 1px solid transparent;
    }
    header-component:not(.not-top) #headerExpandContent::after {
      visibility: visible;
      bottom: -1rem;
      opacity: 1;
      background-color: hsl(var(--muted) / 1);
      border-bottom-color: hsl(var(--border) / 1);
    }
    header-component:not(.expanded) #headerExpandContent {
      pointer-events: none;
    }
  }

  #toggleDarkMode {
    &[data-theme='dark'] {
      & .system {
        display: none;
      }
      & .dark {
        display: block;
      }
    }
    &[data-theme='light'] {
      & .system {
        display: none;
      }
      & .light {
        display: block;
      }
    }
  }
</style>
