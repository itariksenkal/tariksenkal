---
import type { Publications } from '@/data/publications'
import type { Lang } from '@/i18n'
import Glyph from './Glyph.astro'

interface Props {
  lang: Lang
  data: Publications
}
const { lang, data } = Astro.props

const ui = {
  tr: {
    title: 'Yayınlar',
    sub: 'Akademik çalışmalarım ve Google Scholar verileri',
    citations: 'atıf',
    hIndex: 'h-indeks',
    i10: 'i10-indeks',
    scholar: 'Google Scholar profili',
    asOf: (d: string) => `${d} itibarıyla Google Scholar verileri`,
    cited: (n: number) => `${n} atıf`
  },
  en: {
    title: 'Publications',
    sub: 'My academic work and Google Scholar metrics',
    citations: 'citations',
    hIndex: 'h-index',
    i10: 'i10-index',
    scholar: 'Google Scholar profile',
    asOf: (d: string) => `Google Scholar data as of ${d}`,
    cited: (n: number) => `Cited by ${n}`
  }
}[lang]

const metrics = [
  { value: data.metrics.citations, label: ui.citations },
  { value: data.metrics.hIndex, label: ui.hIndex },
  { value: data.metrics.i10, label: ui.i10 }
]
---

<section id='publications' class='reveal scroll-mt-24'>
  <div class='flex flex-wrap items-end justify-between gap-4'>
    <div>
      <h2 class='section-title'>{ui.title}</h2>
      <p class='mt-2 text-muted-foreground'>{ui.sub}</p>
    </div>
    <a href={data.scholarUrl} target='_blank' rel='noopener' class='chip'>
      <Glyph name='book' class='size-4' />
      {ui.scholar}
      <Glyph name='arrow-up-right' class='size-3.5' />
    </a>
  </div>

  <dl class='mt-6 grid grid-cols-3 gap-3 sm:max-w-md'>
    {
      metrics.map((m) => (
        <div class='surface px-3 py-4 text-center'>
          <dt class='sr-only'>{m.label}</dt>
          <dd class='text-2xl font-medium'>{m.value}</dd>
          <dd class='mt-0.5 text-xs text-muted-foreground'>{m.label}</dd>
        </div>
      ))
    }
  </dl>

  <ul class='mt-4 flex flex-col gap-3'>
    {
      data.items.map((x) => (
        <li class='surface spotlight hoverable p-5'>
          <div class='flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground'>
            <span class='font-medium text-primary'>{x.year}</span>
            <span>{x.venue}</span>
            <span>{x.details}</span>
          </div>
          <h3 class='mt-2 text-lg font-medium leading-snug'>
            <a href={`https://doi.org/${x.doi}`} target='_blank' rel='noopener' class='hover:text-primary'>
              {x.title}
            </a>
          </h3>
          <p class='mt-2 text-sm text-muted-foreground'>
            {x.authors.map((a, i) => (
              <Fragment>
                {i > 0 && ', '}
                {i === x.me ? <strong class='font-medium text-foreground'>{a}</strong> : a}
              </Fragment>
            ))}
          </p>
          <p class='mt-3 text-sm text-muted-foreground'>{x.summary[lang]}</p>
          <div class='mt-4 flex flex-wrap items-center gap-2'>
            {x.tags[lang].map((tg) => <span class='chip'>{tg}</span>)}
            <span class='chip'>{ui.cited(x.citations)}</span>
            <a href={`https://doi.org/${x.doi}`} target='_blank' rel='noopener' class='chip'>
              DOI
              <Glyph name='arrow-up-right' class='size-3.5' />
            </a>
          </div>
        </li>
      ))
    }
  </ul>
  <p class='mt-3 text-xs text-muted-foreground'>{ui.asOf(data.asOf[lang])}</p>
</section>
