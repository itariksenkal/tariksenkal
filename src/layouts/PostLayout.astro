---
import type { MarkdownHeading } from 'astro'
import { Image } from 'astro:assets'

import { MediumZoom } from 'astro-pure/advanced'
import { BackToTop } from 'astro-pure/components/pages'
import avatar from '@/assets/avatar.jpeg'
import Glyph from '@/components/site/Glyph.astro'
import PostCard from '@/components/site/PostCard.astro'
import TOC from '@/components/site/toc/TOC.astro'
import { profile, site } from '@/data/profile'
import { formatDate, paths, postUrl, readingMinutes, relatedPosts, t, type Post } from '@/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'

interface Props {
  post: Post
  posts: Post[]
  headings: MarkdownHeading[]
  /** URL of the translated post, if any */
  altHref?: string
}

const { post, posts, headings, altHref } = Astro.props
const { data } = post
const lang = data.lang
const s = t(lang)
const p = profile[lang]
const minutes = readingMinutes(post.body)
const url = new URL(postUrl(post), site.url).href

const idx = posts.findIndex((x) => x.id === post.id)
const newer = idx > 0 ? posts[idx - 1] : undefined
const older = idx < posts.length - 1 ? posts[idx + 1] : undefined
const related = relatedPosts(post, posts, 3)
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3)
const ogImage = data.heroImage ? data.heroImage.src.src : undefined
const published = data.publishDate.toISOString()
const modified = (data.updatedDate ?? data.publishDate).toISOString()
const heroURL = data.heroImage ? new URL(data.heroImage.src.src, site.url).href : new URL('/og-card.jpg', site.url).href
const homeURL = new URL(paths.home(lang), site.url).href
const blogURL = new URL(paths.blog(lang), site.url).href
const words = (post.body ?? '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    image: [heroURL],
    inLanguage: lang,
    datePublished: published,
    dateModified: modified,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    url,
    articleSection: data.category,
    keywords: data.tags.join(', '),
    wordCount: words,
    isPartOf: { '@type': 'Blog', name: `${site.name} — ${s.nav.blog}`, url: blogURL },
    author: {
      '@type': 'Person',
      name: site.name,
      url: homeURL,
      image: new URL('/og-card.jpg', site.url).href,
      sameAs: site.socials.map((x) => x.href),
      worksFor: site.companies.map((c) => ({ '@type': 'Organization', name: c.legal, url: c.url }))
    },
    publisher: { '@type': 'Person', name: site.name, url: site.url }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.shortName, item: homeURL },
      { '@type': 'ListItem', position: 2, name: s.nav.blog, item: blogURL },
      { '@type': 'ListItem', position: 3, name: data.title, item: url }
    ]
  }
]
---

<BaseLayout
  {lang}
  {altHref}
  progress
  meta={{ title: data.title, description: data.description, ogImage, articleDate: published, modifiedDate: modified, jsonLd }}
>
  <a
    href={paths.blog(lang)}
    class='group inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground'
  >
    <Glyph name='arrow-left' class='size-4 transition-transform group-hover:-translate-x-0.5' />
    {s.nav.blog}
  </a>

  <main class='mt-6 items-start gap-x-10 md:flex'>
    {/* Sidebar: table of contents */}
    {
      tocHeadings.length > 1 && (
        <aside
          class='animate top-24 min-w-48 basis-60 overflow-y-auto max-md:hidden z-40 fixed md:sticky md:order-2 lg:shrink-0 max-md:border max-md:px-4 max-md:py-3 max-md:bg-muted max-md:rounded-xl'
          style='max-height:calc(100vh - 8rem);'
          id='sidebar'
        >
          <TOC headings={tocHeadings} title={s.toc} />
          {altHref && (
            <a href={altHref} hreflang={lang === 'tr' ? 'en' : 'tr'} class='chip mt-6'>
              <Glyph name='globe' class='size-4' />
              {s.readIn}
            </a>
          )}
        </aside>
      )
    }
    <div id='sidebar-shade' class='fixed top-0 start-0 w-full h-full' style='display:none;background-color:#00000091;z-index:31'></div>

    <article data-pagefind-body class='min-w-0 grow'>
      <header id='content-header' class='animate'>
        {
          data.heroImage && (
            <div class='hero-image relative mb-8'>
              <Image
                src={data.heroImage.src}
                alt={data.heroImage.alt ?? data.title}
                widths={[640, 960, 1280]}
                sizes='(min-width: 1024px) 760px, 100vw'
                class='relative z-10 aspect-[2/1] h-auto w-full rounded-2xl object-cover'
                loading='eager'
                fetchpriority='high'
              />
              <Image
                src={data.heroImage.src}
                alt=''
                width={480}
                aria-hidden='true'
                id='blurImage'
                class='absolute inset-x-6 top-6 z-0 h-full w-[calc(100%-3rem)] rounded-3xl object-cover opacity-50 transition-opacity duration-300'
                loading='eager'
              />
            </div>
          )
        }

        <div class='flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted-foreground' data-pagefind-ignore>
          {data.category && <span class='chip !py-0.5 !text-xs font-medium !text-primary'>{data.category}</span>}
          <span class='flex items-center gap-1'>
            <Glyph name='calendar' class='size-4' />
            <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate, lang)}</time>
          </span>
          {
            data.updatedDate && (
              <span class='flex items-center gap-1'>
                {s.updated} <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate, lang)}</time>
              </span>
            )
          }
          <span class='flex items-center gap-1'>
            <Glyph name='clock' class='size-4' />
            {s.minRead(minutes)}
          </span>
        </div>

        <h1 class='mt-4 text-balance text-2xl font-medium leading-tight sm:text-[2.1rem]'>{data.title}</h1>
        <p class='mt-4 text-lg leading-relaxed text-muted-foreground'>{data.description}</p>

        <div class='mt-6 flex items-center gap-3' data-pagefind-ignore>
          <Image src={avatar} alt='' width={80} height={80} class='size-10 rounded-full border object-cover' />
          <div class='text-sm leading-tight'>
            <a href={paths.home(lang)} class='font-medium text-foreground'>{site.name}</a>
            <div class='mt-0.5 text-muted-foreground'>{p.role}</div>
          </div>
        </div>
        <div class='mt-8 w-1/3 border-t'></div>
      </header>

      <div id='content' class:list={['max-w-none animate mt-8 md:min-w-[45ch] overflow-x-hidden', integ.typography?.class]}>
        <slot />
      </div>

      {/* Tags + share */}
      <div class='mt-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between' data-pagefind-ignore>
        <div class='flex flex-wrap gap-2'>
          {
            data.tags.map((tag) => (
              <a class='chip' href={paths.tag(lang, tag)}>
                <Glyph name='hash' class='size-3.5' />
                {tag}
              </a>
            ))
          }
        </div>
        <div class='flex items-center gap-2'>
          <span class='text-sm text-muted-foreground'>{s.share}</span>
          <a
            class='chip !px-2.5'
            target='_blank'
            rel='noopener'
            title='X'
            href={`https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(data.title)}`}
          ><Glyph name='x' class='size-4' /></a>
          <a
            class='chip !px-2.5'
            target='_blank'
            rel='noopener'
            title='LinkedIn'
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`}
          ><Glyph name='linkedin' class='size-4' /></a>
          <button class='chip !px-2.5' type='button' title={s.copyLink} data-copy={url} data-copied={s.copied}>
            <Glyph name='link' class='size-4' />
          </button>
        </div>
      </div>

      {/* Author box */}
      <div class='surface mt-8 flex flex-col gap-4 p-5 sm:flex-row sm:items-center' data-pagefind-ignore>
        <Image src={avatar} alt={site.name} width={128} height={128} class='size-16 shrink-0 rounded-full border object-cover' />
        <div class='flex-1'>
          <div class='text-xs text-muted-foreground'>{s.writtenBy}</div>
          <div class='font-medium'>{site.name}</div>
          <p class='mt-1 text-sm text-muted-foreground'>{p.about.lead}</p>
        </div>
        <div class='flex gap-2'>
          {
            site.socials.slice(0, 2).map((x) => (
              <a class='chip !px-2.5' href={x.href} target='_blank' rel='me noopener' title={x.label}>
                <Glyph name={x.icon} class='size-4' />
              </a>
            ))
          }
          <a class='chip !px-2.5' href={`mailto:${site.email}`} title={s.email}><Glyph name='mail' class='size-4' /></a>
        </div>
      </div>

      {/* Prev / next */}
      <nav class='mt-8 grid gap-3 sm:grid-cols-2' data-pagefind-ignore>
        {
          older ? (
            <a href={postUrl(older)} class='surface group flex flex-col gap-1 p-4'>
              <span class='flex items-center gap-1 text-xs text-muted-foreground'>
                <Glyph name='arrow-left' class='size-3.5' />
                {s.prev}
              </span>
              <span class='font-medium transition-colors group-hover:text-primary'>{older.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          newer && (
            <a href={postUrl(newer)} class='surface group flex flex-col gap-1 p-4 text-right sm:col-start-2'>
              <span class='flex items-center justify-end gap-1 text-xs text-muted-foreground'>
                {s.next}
                <Glyph name='arrow' class='size-3.5' />
              </span>
              <span class='font-medium transition-colors group-hover:text-primary'>{newer.data.title}</span>
            </a>
          )
        }
      </nav>
    </article>
  </main>

  {
    related.length > 0 && (
      <section class='mt-16'>
        <h2 class='section-title'>{s.related}</h2>
        <ul class='mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3'>
          {related.map((r) => <PostCard post={r} />)}
        </ul>
      </section>
    )
  }

  <BackToTop header='content-header' content='content'>
    {
      tocHeadings.length > 1 && (
        <button
          slot='other-icons'
          aria-label={s.toc}
          class='size-10 flex items-center justify-center rounded-full border-2 border-transparent bg-muted text-muted-foreground duration-300 hover:border-border/75 md:hidden sm:size-12'
          id='sidebar-btn'
        >
          <Glyph name='list' />
        </button>
      )
    }
  </BackToTop>
</BaseLayout>

{integ.mediumZoom?.enable && <MediumZoom />}

<script>
  import { showToast } from 'astro-pure/utils'

  // Copy link
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy || location.href)
        showToast({ message: btn.dataset.copied || 'Copied' })
      } catch {}
    })
  )

  // Mobile TOC drawer
  const sidebarButton = document.getElementById('sidebar-btn')
  const sidebar = document.getElementById('sidebar')
  const shade = document.getElementById('sidebar-shade') as HTMLElement | null
  const toggle = () => {
    if (!sidebar || !shade) return
    const open = sidebar.classList.toggle('show')
    shade.style.display = open ? 'block' : 'none'
  }
  sidebarButton?.addEventListener('click', toggle)
  shade?.addEventListener('click', toggle)
  sidebar?.querySelectorAll('a[href^="#"]').forEach((a) =>
    a.addEventListener('click', () => sidebar.classList.contains('show') && toggle())
  )

  // Fade the blurred hero glow while scrolling
  const blur = document.getElementById('blurImage') as HTMLImageElement | null
  if (blur) {
    const h = window.innerHeight
    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY
        blur.style.opacity = y > h / 3 ? '0.12' : y > h / 5 ? '0.25' : '0.5'
      },
      { passive: true }
    )
  }
</script>

<style>
  #blurImage {
    filter: blur(28px);
  }
  @media (min-width: 769px) {
    #sidebar-shade {
      display: none !important;
    }
  }
  @media (max-width: 769px) {
    aside.show {
      display: block !important;
      opacity: 1;
      animation: 300ms fade-in-side;
      right: 0;
      top: 0 !important;
      height: 100vh !important;
      max-height: 100vh !important;
      min-width: 60vw !important;
      max-width: 80vw !important;
      border-top-right-radius: 0 !important;
      border-bottom-right-radius: 0 !important;
      padding-top: 1.5rem !important;
      padding-bottom: 1.5rem !important;
    }
    @keyframes fade-in-side {
      0% {
        transform: translateX(50%);
        opacity: 0;
      }
      100% {
        transform: translateX(0);
        opacity: 1;
      }
    }
  }
</style>
