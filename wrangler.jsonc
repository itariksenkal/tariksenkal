{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site: `npm run build`, then `npx wrangler deploy` uploads dist/ (done by .github/workflows/*.yml).
  "name": "tariksenkal",
  "account_id": "e07cc95a4bfeeedf91d01a3e9f03bc0d",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page",
    // /posts/x and /posts/x/ both reach dist/posts/x/index.html; the slash form is canonical.
    "html_handling": "auto-trailing-slash"
  },
  // Custom domains: Cloudflare creates the DNS records and certificates for these.
  "routes": [
    { "pattern": "tariksenkal.com", "custom_domain": true },
    { "pattern": "www.tariksenkal.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
